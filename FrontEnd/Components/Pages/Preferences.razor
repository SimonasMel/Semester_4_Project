@page "/preferences"
@inject CarService CarService
@inject NavigationManager Nav
@using Shared.Models

<div class="max-w-6xl mx-auto p-8">
    <h2 class="text-3xl font-bold mb-2 text-primary">My Preferences</h2>
    <p class="text-text-muted dark:text-gray-400 mb-8 text-sm">Tick the preferences you want factored into your recommendations.</p>

    <div class="bg-white dark:bg-surface-dark rounded-2xl border border-slate-200 dark:border-slate-800 shadow-light-soft dark:shadow-soft p-8 flex flex-col gap-8">

        @* Brand *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <input type="checkbox" id="chk-brand" @bind="prefs.UseBrand"
                       class="w-5 h-5 accent-primary cursor-pointer" />
                <label for="chk-brand" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Preferred Brand</label>
            </div>
            <div class="transition-opacity duration-200 @(!prefs.UseBrand ? "opacity-30 pointer-events-none" : "")">
                <input @bind="prefs.PreferredBrand" placeholder="e.g. BMW, Toyota"
                       class="w-full rounded-xl border border-slate-200 dark:border-slate-700 bg-transparent px-4 py-3 text-text-dark dark:text-text-light focus:outline-none focus:border-primary transition-all" />
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Preferred Year *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <input type="checkbox" id="chk-year" @bind="prefs.UseYear"
                           class="w-5 h-5 accent-primary cursor-pointer" />
                    <label for="chk-year" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Preferred Year</label>
                </div>
                <span class="text-primary font-bold">@(prefs.PreferredYear ?? 2003)</span>
            </div>
            <div class="transition-opacity duration-200 @(!prefs.UseYear ? "opacity-30 pointer-events-none" : "")">
                <input type="range" min="1980" max="2026" step="1"
                       value="@(prefs.PreferredYear ?? 2003)"
                       @oninput="e => prefs.PreferredYear = int.Parse(e.Value!.ToString()!)"
                       class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary bg-slate-200 dark:bg-slate-700" />
                <div class="flex justify-between text-xs text-text-muted mt-1">
                    <span>1980</span><span>2026</span>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Preferred Price *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <input type="checkbox" id="chk-price" @bind="prefs.UsePrice"
                           class="w-5 h-5 accent-primary cursor-pointer" />
                    <label for="chk-price" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Preferred Price</label>
                </div>
                <span class="text-primary font-bold">€@((prefs.PreferredPrice ?? 20000).ToString("N0"))</span>
            </div>
            <div class="transition-opacity duration-200 @(!prefs.UsePrice ? "opacity-30 pointer-events-none" : "")">
                <input type="range" min="0" max="200000" step="500"
                       value="@(prefs.PreferredPrice ?? 20000)"
                       @oninput="e => prefs.PreferredPrice = decimal.Parse(e.Value!.ToString()!)"
                       class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary bg-slate-200 dark:bg-slate-700" />
                <div class="flex justify-between text-xs text-text-muted mt-1">
                    <span>€0</span><span>€200,000</span>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Preferred Mileage *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <input type="checkbox" id="chk-mileage" @bind="prefs.UseMileage"
                           class="w-5 h-5 accent-primary cursor-pointer" />
                    <label for="chk-mileage" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Preferred Mileage</label>
                </div>
                <span class="text-primary font-bold">@((prefs.MileageKm ?? 100000).ToString("N0")) km</span>
            </div>
            <div class="transition-opacity duration-200 @(!prefs.UseMileage ? "opacity-30 pointer-events-none" : "")">
                <input type="range" min="0" max="300000" step="5000"
                       value="@(prefs.MileageKm ?? 100000)"
                       @oninput="e => prefs.MileageKm = int.Parse(e.Value!.ToString()!)"
                       class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary bg-slate-200 dark:bg-slate-700" />
                <div class="flex justify-between text-xs text-text-muted mt-1">
                    <span>0 km</span><span>300,000 km</span>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Preferred Engine Power *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <input type="checkbox" id="chk-power" @bind="prefs.UseEnginePower"
                           class="w-5 h-5 accent-primary cursor-pointer" />
                    <label for="chk-power" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Preferred Engine Power</label>
                </div>
                <span class="text-primary font-bold">@(prefs.EnginePowerKW ?? 100) kW</span>
            </div>
            <div class="transition-opacity duration-200 @(!prefs.UseEnginePower ? "opacity-30 pointer-events-none" : "")">
                <input type="range" min="0" max="500" step="10"
                       value="@(prefs.EnginePowerKW ?? 100)"
                       @oninput="e => prefs.EnginePowerKW = int.Parse(e.Value!.ToString()!)"
                       class="w-full h-2 rounded-full appearance-none cursor-pointer accent-primary bg-slate-200 dark:bg-slate-700" />
                <div class="flex justify-between text-xs text-text-muted mt-1">
                    <span>0 kW</span><span>500 kW</span>
                </div>
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Fuel Type *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <input type="checkbox" id="chk-fuel" @bind="prefs.UseFuelType"
                       class="w-5 h-5 accent-primary cursor-pointer" />
                <label for="chk-fuel" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Fuel Type</label>
            </div>
            <div class="flex flex-wrap gap-2 transition-opacity duration-200 @(!prefs.UseFuelType ? "opacity-30 pointer-events-none" : "")">
                @foreach (var val in Enum.GetValues<FuelCategory>())
                {
                    var v = val;
                    <button @onclick="() => prefs.FuelType = v"
                            class="px-4 py-2 rounded-full text-sm font-bold border transition-all duration-200 @(prefs.FuelType == v ? "bg-primary text-[#022c22] border-primary" : "border-slate-200 dark:border-slate-700 text-text-muted hover:border-primary")">
                        @val
                    </button>
                }
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Transmission *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <input type="checkbox" id="chk-transmission" @bind="prefs.UseTransmission"
                       class="w-5 h-5 accent-primary cursor-pointer" />
                <label for="chk-transmission" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Transmission</label>
            </div>
            <div class="flex flex-wrap gap-2 transition-opacity duration-200 @(!prefs.UseTransmission ? "opacity-30 pointer-events-none" : "")">
                @foreach (var val in Enum.GetValues<TransmissionCategory>())
                {
                    var v = val;
                    <button @onclick="() => prefs.Transmission = v"
                            class="px-4 py-2 rounded-full text-sm font-bold border transition-all duration-200 @(prefs.Transmission == v ? "bg-primary text-[#022c22] border-primary" : "border-slate-200 dark:border-slate-700 text-text-muted hover:border-primary")">
                        @val
                    </button>
                }
            </div>
        </div>

        <div class="border-t border-slate-100 dark:border-slate-800"></div>

        @* Body Type *@
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3">
                <input type="checkbox" id="chk-body" @bind="prefs.UseBodyType"
                       class="w-5 h-5 accent-primary cursor-pointer" />
                <label for="chk-body" class="text-base font-bold text-text-dark dark:text-text-light cursor-pointer">Body Type</label>
            </div>
            <div class="flex flex-wrap gap-2 transition-opacity duration-200 @(!prefs.UseBodyType ? "opacity-30 pointer-events-none" : "")">
                @foreach (var val in Enum.GetValues<BodyCategory>())
                {
                    var v = val;
                    <button @onclick="() => prefs.BodyType = v"
                            class="px-4 py-2 rounded-full text-sm font-bold border transition-all duration-200 @(prefs.BodyType == v ? "bg-primary text-[#022c22] border-primary" : "border-slate-200 dark:border-slate-700 text-text-muted hover:border-primary")">
                        @val
                    </button>
                }
            </div>
        </div>

        @* Save *@
        <button @onclick="Save"
                class="mt-2 px-8 py-4 bg-primary text-[#022c22] rounded-full font-bold text-base hover:bg-green-400 transition-all duration-200 shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-[0.98]">
            @(saved ? "✓ Saved!" : "Save Preferences")
        </button>

    </div>
</div>

@code {
    private UserPreferences prefs = new()
    {
        PreferredYear = 2003,
        PreferredPrice = 20000,
        MileageKm = 100000,
        EnginePowerKW = 100
    };

    private bool saved = false;

    protected override async Task OnInitializedAsync()
    {
        var loaded = await CarService.GetPreferencesAsync();
        if (loaded != null)
        {
            prefs = loaded;
            prefs.PreferredYear ??= 2003;
            prefs.PreferredPrice ??= 20000;
            prefs.MileageKm ??= 100000;
            prefs.EnginePowerKW ??= 100;
        }
    }

    private async Task Save()
    {
        await CarService.SavePreferencesAsync(prefs);
        saved = true;
        await Task.Delay(2000);
        saved = false;
        StateHasChanged();
    }
}